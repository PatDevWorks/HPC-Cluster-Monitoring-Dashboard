# HPC AI Operations Dashboard - Environment Configuration Example
# Copy this file to backend/.env and fill in your environment values.
# Never commit real API keys or secrets to version control.

# Prometheus endpoint (via local SSH tunnel or direct cluster URL)
PROMETHEUS_URL=http://localhost:9090

# Head Node SSH gateway (used automatically by Slurm collector, Node Logs, & launcher)
HPC_SSH_HOST=
HPC_SSH_USER=ubuntu
HPC_SSH_PORT=443
HPC_SSH_KEY_PATH=

# Predictive ML Model APIs (optional if forwarded on localhost:8101 / localhost:8102)
V7_API_URL=http://localhost:8101
V7_API_KEY=
LSTM_V8_API_URL=http://localhost:8102
LSTM_V8_API_KEY=

# Gemini LLM Intelligence & Narrative Reports
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional email alert notifications (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=HPC AI Operations Dashboard

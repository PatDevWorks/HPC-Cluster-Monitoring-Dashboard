import json
import sqlite3
import threading
from datetime import datetime, timedelta, timezone
from typing import Any, Dict, List, Optional

from .config import ALERT_POLICY, DB_PATH, GRAFANA_URL, PROMETHEUS_URL

_db_lock = threading.Lock()


def _utc_now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def get_conn() -> sqlite3.Connection:
    conn = sqlite3.connect(str(DB_PATH), check_same_thread=False)
    conn.row_factory = sqlite3.Row
    return conn


def init_db() -> None:
    with _db_lock:
        conn = get_conn()
        try:
            conn.executescript(
                """
                CREATE TABLE IF NOT EXISTS alert_episodes (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    node_id TEXT NOT NULL,
                    priority TEXT NOT NULL,
                    status TEXT NOT NULL DEFAULT 'active',
                    fault_class TEXT NOT NULL,
                    title TEXT NOT NULL,
                    summary TEXT NOT NULL,
                    playbook_cmd TEXT NOT NULL,
                    start_utc TEXT NOT NULL,
                    last_seen_utc TEXT NOT NULL,
                    resolved_utc TEXT,
                    alert_points INTEGER NOT NULL DEFAULT 1,
                    consensus_votes INTEGER NOT NULL DEFAULT 0,
                    max_failure_prob REAL NOT NULL DEFAULT 0.0,
                    max_anomaly_score REAL NOT NULL DEFAULT 0.0,
                    top_features_json TEXT NOT NULL DEFAULT '[]',
                    silenced_until_utc TEXT,
                    data_mode TEXT NOT NULL DEFAULT 'live_prometheus'
                );

                CREATE TABLE IF NOT EXISTS slurm_actions_audit (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    timestamp_utc TEXT NOT NULL,
                    node_id TEXT NOT NULL,
                    action TEXT NOT NULL,
                    reason TEXT NOT NULL,
                    jobs_protected INTEGER NOT NULL DEFAULT 0,
                    core_hours_saved REAL NOT NULL DEFAULT 0.0,
                    kwh_saved REAL NOT NULL DEFAULT 0.0,
                    executed_mode TEXT NOT NULL
                );

                CREATE TABLE IF NOT EXISTS system_logs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    timestamp_utc TEXT NOT NULL,
                    node_id TEXT NOT NULL,
                    source TEXT NOT NULL,
                    severity TEXT NOT NULL,
                    event_type TEXT NOT NULL,
                    message TEXT NOT NULL
                );

                CREATE TABLE IF NOT EXISTS telemetry_history (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    timestamp_utc TEXT NOT NULL,
                    data_mode TEXT NOT NULL,
                    node_id TEXT NOT NULL,
                    up INTEGER NOT NULL DEFAULT 1,
                    health_score REAL,
                    cpu_percent REAL,
                    iowait_percent REAL,
                    memory_percent REAL,
                    swap_percent REAL,
                    load1 REAL,
                    normalized_load1 REAL,
                    scratch_percent REAL,
                    disk_read_mb REAL,
                    disk_write_mb REAL,
                    disk_io_percent REAL,
                    net_rx_mb REAL,
                    net_tx_mb REAL,
                    net_err_s REAL,
                    temp_celsius REAL,
                    failure_prob_1h REAL,
                    failure_prob_6h REAL,
                    anomaly_score REAL,
                    consensus_count INTEGER
                );

                CREATE INDEX IF NOT EXISTS idx_telemetry_ts_node
                    ON telemetry_history (timestamp_utc, node_id);

                CREATE TABLE IF NOT EXISTS app_settings (
                    key TEXT PRIMARY KEY,
                    value_json TEXT NOT NULL,
                    updated_utc TEXT NOT NULL
                );

                                CREATE TABLE IF NOT EXISTS ai_reports (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    report_type TEXT NOT NULL,
                    title TEXT NOT NULL,
                    created_utc TEXT NOT NULL,
                    range_minutes INTEGER NOT NULL,
                    data_mode TEXT NOT NULL,
                    provider TEXT NOT NULL,
                    model TEXT NOT NULL,
                    prompt_version TEXT NOT NULL,
                    node_ids_json TEXT NOT NULL DEFAULT '[]',
                    evidence_json TEXT NOT NULL DEFAULT '{}',
                    report_text TEXT NOT NULL,
                    status TEXT NOT NULL DEFAULT 'completed'
                );

                CREATE INDEX IF NOT EXISTS idx_ai_reports_created
                    ON ai_reports (created_utc DESC);
                """
            )
            conn.commit()
        finally:
            conn.close()

# ---------------------------------------------------------------------------
# AI-Generated Report Storage
# ---------------------------------------------------------------------------

def save_ai_report(
    report_type: str,
    title: str,
    range_minutes: int,
    data_mode: str,
    provider: str,
    model: str,
    prompt_version: str,
    node_ids: List[str],
    evidence: Dict[str, Any],
    report_text: str,
    status: str = "completed",
) -> int:
    created_utc = _utc_now_iso()

    with _db_lock:
        conn = get_conn()
        try:
            cursor = conn.execute(
                """
                INSERT INTO ai_reports (
                    report_type,
                    title,
                    created_utc,
                    range_minutes,
                    data_mode,
                    provider,
                    model,
                    prompt_version,
                    node_ids_json,
                    evidence_json,
                    report_text,
                    status
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    report_type,
                    title,
                    created_utc,
                    range_minutes,
                    data_mode,
                    provider,
                    model,
                    prompt_version,
                    json.dumps(node_ids),
                    json.dumps(evidence),
                    report_text,
                    status,
                ),
            )
            conn.commit()
            return int(cursor.lastrowid)
        finally:
            conn.close()


def get_ai_report(report_id: int) -> Optional[Dict[str, Any]]:
    with _db_lock:
        conn = get_conn()
        try:
            row = conn.execute(
                "SELECT * FROM ai_reports WHERE id = ?",
                (report_id,),
            ).fetchone()

            if not row:
                return None

            result = dict(row)
            result["node_ids"] = json.loads(result.pop("node_ids_json"))
            result["evidence"] = json.loads(result.pop("evidence_json"))

            return result
        finally:
            conn.close()


def list_ai_reports(limit: int = 50) -> List[Dict[str, Any]]:
    limit = max(1, min(int(limit), 200))

    with _db_lock:
        conn = get_conn()
        try:
            rows = conn.execute(
                """
                SELECT
                    id,
                    report_type,
                    title,
                    created_utc,
                    range_minutes,
                    data_mode,
                    provider,
                    model,
                    prompt_version,
                    node_ids_json,
                    status
                FROM ai_reports
                ORDER BY id DESC
                LIMIT ?
                """,
                (limit,),
            ).fetchall()

            results = []

            for row in rows:
                item = dict(row)
                item["node_ids"] = json.loads(item.pop("node_ids_json"))
                results.append(item)

            return results
        finally:
            conn.close()

def update_ai_report(
    report_id: int,
    status: str,
    report_text: Optional[str] = None,
) -> bool:
    """
    Update the status and optionally the generated text
    of an existing AI report.
    """

    allowed_statuses = {
        "pending",
        "generating",
        "completed",
        "failed",
    }

    if status not in allowed_statuses:
        raise ValueError("Invalid AI report status.")

    with _db_lock:
        conn = get_conn()
        try:
            cursor = conn.execute(
                """
                UPDATE ai_reports
                SET status = ?,
                    report_text = COALESCE(?, report_text)
                WHERE id = ?
                """,
                (status, report_text, report_id),
            )

            conn.commit()
            return cursor.rowcount > 0

        finally:
            conn.close()

# ---------------------------------------------------------------------------
# Persistent Application Settings
# ---------------------------------------------------------------------------

DEFAULT_SETTINGS: Dict[str, Any] = {
    "prometheus_url": PROMETHEUS_URL,
    "grafana_url": GRAFANA_URL,
    "refresh_interval_sec": 3.0,
    "ssh_host": "",
    "ssh_user": "ubuntu",
    "ssh_port": 22,
    "alert_policy": dict(ALERT_POLICY),
    "node_overrides": {},
}


def get_app_settings() -> Dict[str, Any]:
    merged = json.loads(json.dumps(DEFAULT_SETTINGS))
    with _db_lock:
        conn = get_conn()
        try:
            rows = conn.execute("SELECT key, value_json FROM app_settings").fetchall()
            for r in rows:
                try:
                    val = json.loads(r["value_json"])
                    if r["key"] == "alert_policy" and isinstance(val, dict):
                        merged["alert_policy"].update(val)
                    else:
                        merged[r["key"]] = val
                except Exception:
                    pass
        finally:
            conn.close()
    return merged


def update_app_settings(updates: Dict[str, Any]) -> Dict[str, Any]:
    now_iso = _utc_now_iso()
    allowed_keys = {
        "prometheus_url",
        "grafana_url",
        "refresh_interval_sec",
        "ssh_host",
        "ssh_user",
        "ssh_port",
        "alert_policy",
        "node_overrides",
    }
    with _db_lock:
        conn = get_conn()
        try:
            for key, val in updates.items():
                if key not in allowed_keys or val is None:
                    continue
                conn.execute(
                    """
                    INSERT INTO app_settings (key, value_json, updated_utc)
                    VALUES (?, ?, ?)
                    ON CONFLICT(key) DO UPDATE SET
                        value_json = excluded.value_json,
                        updated_utc = excluded.updated_utc
                    """,
                    (key, json.dumps(val), now_iso),
                )
            conn.commit()
        finally:
            conn.close()
    return get_app_settings()


# ---------------------------------------------------------------------------
# Telemetry & Prediction History Recording (for Analytics & CSV/PDF Reports)
# ---------------------------------------------------------------------------

def record_telemetry_batch(
    timestamp_utc: str, data_mode: str, scored_nodes: List[Dict[str, Any]]
) -> None:
    if not scored_nodes:
        return
    rows = []
    for n in scored_nodes:
        dr = n.get("disk_read_bytes_per_second")
        dw = n.get("disk_write_bytes_per_second")
        nrx = n.get("network_receive_bytes_per_second")
        ntx = n.get("network_transmit_bytes_per_second")
        rows.append(
            (
                timestamp_utc,
                data_mode,
                str(n.get("node_id", "unknown")),
                int(n.get("up", 1) if n.get("up") is not None else 0),
                n.get("node_health_score"),
                n.get("cpu_utilization_percent"),
                n.get("cpu_iowait_percent"),
                n.get("memory_used_percent"),
                n.get("swap_used_percent"),
                n.get("load1"),
                n.get("normalized_load1"),
                n.get("scratch_used_percent"),
                round(float(dr) / (1024 * 1024), 3) if dr is not None else None,
                round(float(dw) / (1024 * 1024), 3) if dw is not None else None,
                n.get("disk_io_utilization_percent"),
                round(float(nrx) / (1024 * 1024), 3) if nrx is not None else None,
                round(float(ntx) / (1024 * 1024), 3) if ntx is not None else None,
                n.get("network_errors_per_second"),
                n.get("cpu_temperature_celsius"),
                n.get("failure_prob_1h"),
                n.get("failure_prob_6h"),
                n.get("anomaly_score"),
                int(n.get("consensus_count", 0)),
            )
        )
    with _db_lock:
        conn = get_conn()
        try:
            conn.executemany(
                """
                INSERT INTO telemetry_history (
                    timestamp_utc, data_mode, node_id, up, health_score,
                    cpu_percent, iowait_percent, memory_percent, swap_percent,
                    load1, normalized_load1, scratch_percent,
                    disk_read_mb, disk_write_mb, disk_io_percent,
                    net_rx_mb, net_tx_mb, net_err_s, temp_celsius,
                    failure_prob_1h, failure_prob_6h, anomaly_score, consensus_count
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                rows,
            )
            # Keep bounded to ~12,000 rows (~24h of 4-node history)
            conn.execute(
                """
                DELETE FROM telemetry_history
                WHERE id < COALESCE((SELECT MAX(id) - 12000 FROM telemetry_history), 0)
                """
            )
            conn.commit()
        finally:
            conn.close()


def query_telemetry_history(
    range_minutes: Optional[int] = 60,
    node_id: Optional[str] = None,
    limit: int = 1200,
) -> List[Dict[str, Any]]:
    with _db_lock:
        conn = get_conn()
        try:
            clauses = []
            params: List[Any] = []
            if node_id:
                clauses.append("node_id = ?")
                params.append(node_id)
            if range_minutes and range_minutes > 0:
                # Only filter by wall-clock cutoff for non-replay live modes;
                # if table has synthetic timestamps in 2026-08/09, return latest rows cleanly.
                cutoff = (
                    datetime.now(timezone.utc) - timedelta(minutes=range_minutes)
                ).strftime("%Y-%m-%dT%H:%M:%SZ")
                count_recent = conn.execute(
                    "SELECT COUNT(*) AS c FROM telemetry_history WHERE timestamp_utc >= ?",
                    (cutoff,),
                ).fetchone()["c"]
                if count_recent > 0:
                    clauses.append("timestamp_utc >= ?")
                    params.append(cutoff)

            where_sql = f"WHERE {' AND '.join(clauses)}" if clauses else ""
            params.append(limit)
            rows = conn.execute(
                f"""
                SELECT * FROM (
                    SELECT * FROM telemetry_history
                    {where_sql}
                    ORDER BY id DESC
                    LIMIT ?
                ) sub
                ORDER BY id ASC
                """,
                params,
            ).fetchall()
            return [dict(r) for r in rows]
        finally:
            conn.close()


# ---------------------------------------------------------------------------
# Alert Episodes, Slurm Audit & System Logs
# ---------------------------------------------------------------------------

def upsert_alert_episode(
    node_id: str,
    priority: str,
    fault_class: str,
    title: str,
    summary: str,
    playbook_cmd: str,
    timestamp_utc: str,
    consensus_votes: int,
    failure_prob: float,
    anomaly_score: float,
    top_features: List[Dict[str, Any]],
    data_mode: str,
) -> Dict[str, Any]:
    """Create or update an active/acknowledged alert episode for a node."""
    priority_rank = {"P3": 1, "P2": 2, "P1": 3}
    with _db_lock:
        conn = get_conn()
        try:
            row = conn.execute(
                """
                SELECT * FROM alert_episodes
                WHERE node_id = ? AND status IN ('active', 'acknowledged', 'silenced')
                ORDER BY id DESC LIMIT 1
                """,
                (node_id,),
            ).fetchone()

            top_json = json.dumps(top_features)
            if row:
                new_prio = (
                    priority
                    if priority_rank.get(priority, 1) >= priority_rank.get(row["priority"], 1)
                    else row["priority"]
                )
                new_status = row["status"]
                if priority == "P1" and row["priority"] != "P1":
                    new_status = "active"

                conn.execute(
                    """
                    UPDATE alert_episodes
                    SET priority = ?,
                        status = ?,
                        fault_class = ?,
                        title = ?,
                        summary = ?,
                        playbook_cmd = ?,
                        last_seen_utc = ?,
                        alert_points = alert_points + 1,
                        consensus_votes = MAX(consensus_votes, ?),
                        max_failure_prob = MAX(max_failure_prob, ?),
                        max_anomaly_score = MAX(max_anomaly_score, ?),
                        top_features_json = ?
                    WHERE id = ?
                    """,
                    (
                        new_prio,
                        new_status,
                        fault_class,
                        title,
                        summary,
                        playbook_cmd,
                        timestamp_utc,
                        consensus_votes,
                        failure_prob,
                        anomaly_score,
                        top_json,
                        row["id"],
                    ),
                )
                conn.commit()
                updated = conn.execute(
                    "SELECT * FROM alert_episodes WHERE id = ?", (row["id"],)
                ).fetchone()
                return _row_to_episode(updated)
            else:
                cur = conn.execute(
                    """
                    INSERT INTO alert_episodes (
                        node_id, priority, status, fault_class, title, summary,
                        playbook_cmd, start_utc, last_seen_utc, alert_points,
                        consensus_votes, max_failure_prob, max_anomaly_score,
                        top_features_json, data_mode
                    ) VALUES (?, ?, 'active', ?, ?, ?, ?, ?, ?, 1, ?, ?, ?, ?, ?)
                    """,
                    (
                        node_id,
                        priority,
                        fault_class,
                        title,
                        summary,
                        playbook_cmd,
                        timestamp_utc,
                        timestamp_utc,
                        consensus_votes,
                        failure_prob,
                        anomaly_score,
                        top_json,
                        data_mode,
                    ),
                )
                conn.commit()
                created = conn.execute(
                    "SELECT * FROM alert_episodes WHERE id = ?", (cur.lastrowid,)
                ).fetchone()
                return _row_to_episode(created)
        finally:
            conn.close()


def auto_resolve_node_episodes(node_id: str, timestamp_utc: str) -> None:
    with _db_lock:
        conn = get_conn()
        try:
            conn.execute(
                """
                UPDATE alert_episodes
                SET status = 'resolved', resolved_utc = ?
                WHERE node_id = ? AND status IN ('active', 'acknowledged')
                """,
                (timestamp_utc, node_id),
            )
            conn.commit()
        finally:
            conn.close()


def update_episode_status(
    episode_id: int, action: str, silenced_until_utc: Optional[str] = None
) -> Optional[Dict[str, Any]]:
    status_map = {
        "acknowledge": "acknowledged",
        "silence": "silenced",
        "resolve": "resolved",
    }
    new_status = status_map.get(action, "acknowledged")
    now_iso = _utc_now_iso()
    with _db_lock:
        conn = get_conn()
        try:
            conn.execute(
                """
                UPDATE alert_episodes
                SET status = ?,
                    silenced_until_utc = COALESCE(?, silenced_until_utc),
                    resolved_utc = CASE WHEN ? = 'resolved' THEN ? ELSE resolved_utc END
                WHERE id = ?
                """,
                (new_status, silenced_until_utc, new_status, now_iso, episode_id),
            )
            conn.commit()
            row = conn.execute(
                "SELECT * FROM alert_episodes WHERE id = ?", (episode_id,)
            ).fetchone()
            return _row_to_episode(row) if row else None
        finally:
            conn.close()


def list_episodes(limit: int = 100) -> List[Dict[str, Any]]:
    with _db_lock:
        conn = get_conn()
        try:
            rows = conn.execute(
                """
                SELECT * FROM alert_episodes
                ORDER BY
                    CASE WHEN status = 'active' THEN 0
                         WHEN status = 'acknowledged' THEN 1
                         WHEN status = 'silenced' THEN 2
                         ELSE 3 END,
                    CASE priority WHEN 'P1' THEN 0 WHEN 'P2' THEN 1 ELSE 2 END,
                    id DESC
                LIMIT ?
                """,
                (limit,),
            ).fetchall()
            return [_row_to_episode(r) for r in rows]
        finally:
            conn.close()


def record_slurm_action(
    node_id: str,
    action: str,
    reason: str,
    jobs_protected: int,
    core_hours_saved: float,
    kwh_saved: float,
    executed_mode: str,
) -> Dict[str, Any]:
    now_iso = _utc_now_iso()
    with _db_lock:
        conn = get_conn()
        try:
            cur = conn.execute(
                """
                INSERT INTO slurm_actions_audit (
                    timestamp_utc, node_id, action, reason,
                    jobs_protected, core_hours_saved, kwh_saved, executed_mode
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    now_iso,
                    node_id,
                    action,
                    reason,
                    jobs_protected,
                    round(core_hours_saved, 2),
                    round(kwh_saved, 3),
                    executed_mode,
                ),
            )
            conn.commit()
            row = conn.execute(
                "SELECT * FROM slurm_actions_audit WHERE id = ?", (cur.lastrowid,)
            ).fetchone()
            return dict(row)
        finally:
            conn.close()


def list_slurm_audit(limit: int = 60) -> List[Dict[str, Any]]:
    with _db_lock:
        conn = get_conn()
        try:
            rows = conn.execute(
                "SELECT * FROM slurm_actions_audit ORDER BY id DESC LIMIT ?", (limit,)
            ).fetchall()
            return [dict(r) for r in rows]
        finally:
            conn.close()


def get_roi_totals() -> Dict[str, Any]:
    with _db_lock:
        conn = get_conn()
        try:
            row = conn.execute(
                """
                SELECT
                    COUNT(*) AS total_drains,
                    COALESCE(SUM(jobs_protected), 0) AS total_jobs_protected,
                    COALESCE(SUM(core_hours_saved), 0.0) AS total_core_hours_saved,
                    COALESCE(SUM(kwh_saved), 0.0) AS total_kwh_saved
                FROM slurm_actions_audit
                WHERE action = 'DRAIN'
                """
            ).fetchone()
            ep_row = conn.execute(
                """
                SELECT COUNT(*) AS predicted_episodes
                FROM alert_episodes
                WHERE priority IN ('P1', 'P2')
                """
            ).fetchone()
            base_core_hrs = float(row["total_core_hours_saved"]) + float(ep_row["predicted_episodes"]) * 38.4
            base_kwh = float(row["total_kwh_saved"]) + float(ep_row["predicted_episodes"]) * 0.52
            return {
                "proactive_drains": int(row["total_drains"]),
                "jobs_protected": int(row["total_jobs_protected"]) + int(ep_row["predicted_episodes"]),
                "core_hours_saved": round(base_core_hrs, 1),
                "kwh_saved": round(base_kwh, 2),
                "zar_energy_saved": round(base_kwh * 3.15, 2),
            }
        finally:
            conn.close()


def add_system_log(
    timestamp_utc: str,
    node_id: str,
    source: str,
    severity: str,
    event_type: str,
    message: str,
) -> None:
    with _db_lock:
        conn = get_conn()
        try:
            last = conn.execute(
                "SELECT message, node_id FROM system_logs ORDER BY id DESC LIMIT 1"
            ).fetchone()
            if last and last["node_id"] == node_id and last["message"] == message:
                return
            conn.execute(
                """
                INSERT INTO system_logs (timestamp_utc, node_id, source, severity, event_type, message)
                VALUES (?, ?, ?, ?, ?, ?)
                """,
                (timestamp_utc, node_id, source, severity, event_type, message),
            )
            conn.execute(
                "DELETE FROM system_logs WHERE id NOT IN (SELECT id FROM system_logs ORDER BY id DESC LIMIT 500)"
            )
            conn.commit()
        finally:
            conn.close()


def list_system_logs(limit: int = 80) -> List[Dict[str, Any]]:
    with _db_lock:
        conn = get_conn()
        try:
            rows = conn.execute(
                "SELECT * FROM system_logs ORDER BY id DESC LIMIT ?", (limit,)
            ).fetchall()
            return [dict(r) for r in rows]
        finally:
            conn.close()


def clear_all_runtime_records() -> None:
    with _db_lock:
        conn = get_conn()
        try:
            conn.execute("DELETE FROM alert_episodes")
            conn.execute("DELETE FROM system_logs")
            conn.execute("DELETE FROM telemetry_history")
            conn.commit()
        finally:
            conn.close()


def _row_to_episode(row: sqlite3.Row) -> Dict[str, Any]:
    d = dict(row)
    sev_map = {"P1": "critical", "P2": "warning", "P3": "info"}
    d["severity"] = sev_map.get(d.get("priority", "P3"), "info")
    try:
        d["top_features"] = json.loads(d.pop("top_features_json", "[]"))
    except Exception:
        d["top_features"] = []
    return d
# backend/app/database.py
def init_app_db() -> None:
    """Called on startup – create tables if missing."""
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    # Existing tables …
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS ml_engine_settings (
            id INTEGER PRIMARY KEY CHECK (id = 1),
            enabled INTEGER NOT NULL CHECK (enabled IN (0,1))
        )
        """
    )
    # Ensure a single row exists (default: enabled)
    cur.execute("INSERT OR IGNORE INTO ml_engine_settings (id, enabled) VALUES (1, 1)")
    conn.commit()
    conn.close()

    # backend/app/database.py
def get_ml_engine_enabled() -> bool:
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("SELECT enabled FROM ml_engine_settings WHERE id = 1")
    row = cur.fetchone()
    conn.close()
    return bool(row[0]) if row else True   # default to enabled

def set_ml_engine_enabled(enabled: bool) -> None:
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute(
        "UPDATE ml_engine_settings SET enabled = ? WHERE id = 1",
        (1 if enabled else 0,),
    )
    conn.commit()
    conn.close()
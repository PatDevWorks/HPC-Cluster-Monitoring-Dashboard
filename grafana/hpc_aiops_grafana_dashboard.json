{
  "title": "Sol Plaatje A — Predictive HPC Cluster AIOps (Prometheus Exporter)",
  "uid": "spu-hpc-aiops-v1",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1-Hour Predicted Failure Probability by Node (0 - 1)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "hpc_aiops_failure_prob_1h",
          "legendFormat": "{{node_id}} ({{rack_id}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ensemble Unsupervised Anomaly Score by Node (0 - 1)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "hpc_aiops_anomaly_score",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Alert Priority Level (0=OK, 1=Watch, 2=Warn, 3=Crit)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "hpc_aiops_alert_priority_level",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Multi-Model Consensus Votes (Out of 4 Detectors)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "hpc_aiops_consensus_votes",
          "legendFormat": "{{node_id}}"
        }
      ]
    }
  ]
}
